[Unit]
Description=marcelinoWeb dashboard
Wants=network-online.target
After=network-online.target marcelinoServer.service

[Service]
Type=simple
User=marcelinoweb
Group=marcelinoweb
EnvironmentFile=/etc/default/marcelinoWeb
ExecStart=/usr/bin/python3 /opt/marcelinoWeb/marcelinoWeb.py --users /etc/marcelinoWeb/users.json serve --host ${MARCELINOWEB_HOST} --port ${MARCELINOWEB_PORT} --status ${MARCELINOWEB_STATUS} $MARCELINOWEB_TLS_ARGS
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
